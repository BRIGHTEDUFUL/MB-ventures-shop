# Production build env: beats .env.local (dev) so local builds inline the
# production Convex deployment instead of the dev one. `npx convex dev` keeps
# writing the dev URL to .env.local.
VITE_CONVEX_URL=https://necessary-newt-861.convex.cloud
VITE_CONVEX_SITE_URL=https://necessary-newt-861.convex.site

# Public origin of the storefront. It drives the canonical link, og:url and the
# social image URL on every page. The domain exists now, so production is
# pinned to it: with no value the pages emit relative URLs instead of a
# confidently wrong absolute one. (.env.development supplies localhost for
# `vite dev` and is never read by `vite build`.)
VITE_SITE_URL=https://mbventuresghana.com

