# ---------------------------------------------------------------------------
# Circle Shop Express — environment template
#
# Copy to `.env.local` (gitignored, day-to-day development) and fill in what
# you need. Values here are placeholders only: never commit a real API key,
# deploy key or password. Convex reads the runtime block through
# `npx convex dev` / `npx convex deploy`; Vite reads the VITE_* block.
# ---------------------------------------------------------------------------

# --- Vite / Convex routing -------------------------------------------------

# Frontend origin of the deployment. `.env` (tracked) carries production so a
# production build needs no extra configuration; `.env.local` overrides it.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public origin of the storefront (scheme + host, no trailing slash), e.g.
# https://mbventuresgh.com. Used only for SEO URLs: <link rel="canonical">,
# og:url and the social card image. Leave it unset and the site simply omits
# those absolute URLs rather than emitting a wrong host.
#   development : http://localhost:5173  (already set in `.env.development`)
#   production  : set in `.env.production` once the domain is known
VITE_SITE_URL=

# --- Convex CLI targets ----------------------------------------------------

# `npm run dev` follows this deployment; `npx convex deploy` needs the key.
# Dev is `dev:stoic-elephant-714`, prod is `prod:necessary-newt-861`.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# --- Runtime origin --------------------------------------------------------

# Absolute origin every link inside an email is built from, and the origin the
# `/dev/email-preview` gallery and the startup assertion in
# `convex/emails/config.ts` are gated on.
#   development : http://localhost:5173
#   production  : https://<your storefront domain>
# Convex also supplies CONVEX_SITE_URL automatically; SITE_URL wins when set.
SITE_URL=

# --- Email delivery (see docs/EMAIL.md) ------------------------------------

# Nothing below is required to run the store. While RESEND_API_KEY *and*
# EMAIL_FROM are both empty the backend runs in dry-run: every message is
# rendered and recorded in `emailLogs`, nothing is transmitted.
#
# RESEND_API_KEY=
# EMAIL_FROM=MB Ventures GH <info@mbventures.test>
# EMAIL_REPLY_TO=orders@mbventuresgh.com
# ADMIN_ALERT_EMAIL=orders@mbventuresgh.com
# EMAIL_DAILY_LIMIT=100
# RESEND_WEBHOOK_SECRET=
# EMAIL_DRY_RUN_LOG_CODES=false

# --- Convex Auth keys (production only) ------------------------------------

# Generated with the @convex-dev/auth CLI. Rotate them if they ever leak.
# JWT_PRIVATE_KEY=
# JWKS=
